    // Asset and Media Management Objects
    private Bitmap busBitmap;
    private MediaPlayer hornPlayer;
    private int busX, busY, busSpeed = 18;
    
    private ArrayList<BDTraffic> trafficList;
    private ArrayList<BDBuilding> environmentList;
    private Random random;
    private int score = 0;

    public GameView(Context context, int screenX, int screenY) {
        super(context);
        this.screenX = screenX;
        this.screenY = screenY;
        surfaceHolder = getHolder();
        paint = new Paint();
        random = new Random();

        // 1. Loading and scaling the real PNG asset from res/drawable/bd_bus.png
        Bitmap originalBitmap = BitmapFactory.decodeResource(getResources(), R.drawable.bd_bus);
        busBitmap = Bitmap.createScaledBitmap(originalBitmap, 160, 90, false);

        // 2. Initializing real hydraulic horn audio from res/raw/hydraulic_horn.mp3
        hornPlayer = MediaPlayer.create(context, R.raw.hydraulic_horn);

        busX = 100;
        busY = screenY / 2;

        trafficList = new ArrayList<>();
        environmentList = new ArrayList<>();

        for (int i = 0; i < 3; i++) {
            generateTraffic();
            generateEnvironment();
        }
    }

    @Override
    public void run() {
        while (isPlaying) {
            update();
            draw();
            control();
        }
    }

    private void update() {
        // Handle incoming Bangladeshi highway traffic calculations
        for (BDTraffic traffic : trafficList) {
            traffic.x -= traffic.speed;
            if (traffic.x < -200) {
                traffic.x = screenX + random.nextInt(300);
                traffic.y = random.nextInt(screenY - 250) + 120;
                traffic.type = random.nextBoolean() ? "Hanif Bus" : "Local Rickshaw";
                score += 10;
            }

            // Real-time accident collision calculation boundary
            if (Math.abs(busX - traffic.x) < 140 && Math.abs(busY - traffic.y) < 60) {
                score = 0; 
            }
        }

        // Side environment scenery movement simulation
        for (BDBuilding building : environmentList) {
            building.x -= 10;
            if (building.x < -300) {
                building.x = screenX + random.nextInt(300);
                building.type = random.nextBoolean() ? "Mudir Dokan" : "BD House";
            }
        }
    }

    private void draw() {
        if (surfaceHolder.getSurface().isValid()) {
            Canvas canvas = surfaceHolder.lockCanvas();

            // Render Green Fields background & Pitch Dark Highway tarmac
            canvas.drawColor(Color.parseColor("#27AE60")); 
            paint.setColor(Color.parseColor("#34495E")); 
            canvas.drawRect(0, 120, screenX, screenY - 120, paint); 

            // White center-line markings setup
            paint.setColor(Color.WHITE);
            for (int i = 0; i < screenX; i += 120) {
                canvas.drawRect(i, screenY / 2 - 4, i + 60, screenY / 2 + 4, paint);
            }

            // Drawing roadside structures (Mudir Dokan / BD Village Houses)
            for (BDBuilding building : environmentList) {
                if (building.type.equals("Mudir Dokan")) {
                    paint.setColor(Color.parseColor("#D35400")); 
                    canvas.drawRect(building.x, 25, building.x + 140, 115, paint);
                    paint.setColor(Color.WHITE);
                    paint.setTextSize(22);
                    canvas.drawText("টং দোকান", building.x + 15, 75, paint);
                } else {
                    paint.setColor(Color.parseColor("#7F8C8D")); 
                    canvas.drawRect(building.x, 15, building.x + 180, 115, paint);
                    paint.setColor(Color.YELLOW);
                    canvas.drawText("গ্রামের বাড়ি", building.x + 20, 70, paint);
                }
            }

            // 3. Render the customized PNG Bus asset model to screen
            canvas.drawBitmap(busBitmap, busX, busY, paint);

            // Render random highway road traffic elements
            for (BDTraffic traffic : trafficList) {
                if (traffic.type.contains("Bus")) {
                    paint.setColor(Color.parseColor("#8E44AD")); 
                    canvas.drawRect(traffic.x, traffic.y, traffic.x + 150, traffic.y + 70, paint);
                    paint.setColor(Color.WHITE);
                    paint.setTextSize(20);
                    canvas.drawText("হানিফ এন্টারপ্রাইজ", traffic.x + 10, traffic.y + 40, paint);
                } else {
                    paint.setColor(Color.parseColor("#F1C40F")); 
                    canvas.drawRect(traffic.x, traffic.y, traffic.x + 70, traffic.y + 55, paint);
                    paint.setColor(Color.BLACK);
                    paint.setTextSize(18);
                    canvas.drawText("রিকশা", traffic.x + 10, traffic.y + 35, paint);
                }
            }

            // Display active highway journey metadata UI
            paint.setColor(Color.WHITE);
            paint.setTextSize(35);
            canvas.drawText("Route: Dhaka - Sylhet Highway", 40, 170, paint);
            canvas.drawText("Score: " + score, screenX - 280, 170, paint);

            surfaceHolder.unlockCanvasAndPost(canvas);
        }
    }

    private void control() {
        try {
            Thread.sleep(17); // Locks performance at target ~60 FPS rate
        } catch (InterruptedException e) {
            e.printStackTrace();
        }
    }

    private void generateTraffic() {
        BDTraffic traffic = new BDTraffic();
        traffic.x = screenX + random.nextInt(400);
        traffic.y = random.nextInt(screenY - 320) + 140;
        traffic.speed = random.nextInt(8) + 12;
        traffic.type = random.nextBoolean() ? "Hanif Bus" : "Local Rickshaw";
        trafficList.add(traffic);
    }

